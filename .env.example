# AI Provider Configuration
NOVA_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
NOVA_GEMINI_MODEL=gemini-3.6-flash
NOVA_OLLAMA_HOST=http://localhost:11434
NOVA_OLLAMA_MODEL=llama3.1

# External API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# System Configuration
DEBUG=false
LOG_LEVEL=INFO

# AI Configuration
AI_MAX_CONTEXT_TURNS=20
AI_RESPONSE_TIMEOUT=30
AI_TEMPERATURE=0.7

# Voice Configuration
VOICE_ENABLED=true
VOICE_RATE=150
VOICE_VOLUME=0.9

# UI Configuration
THEME=dark
GLASSMORPHISM_ENABLED=true
ANIMATIONS_ENABLED=true