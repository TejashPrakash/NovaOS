# Which AI backend to use: gemini or ollama
NOVA_PROVIDER=gemini

# Required when NOVA_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
NOVA_GEMINI_MODEL=gemini-3.6-flash

# Used when NOVA_PROVIDER=ollama
NOVA_OLLAMA_HOST=http://localhost:11434
NOVA_OLLAMA_MODEL=llama3.1